for row_idx, row_data in enumerate(lead_data, start=6):
  ws_pipe.row_dimensions[row_idx].height = 36
  is_zebra = row_idx % 2 == 1

  for col_idx, val in enumerate(row_data, start=1):
    cell = ws_pipe.cell(row=row_idx, column=col_idx)
    cell.value = val
    cell.font = font_body
    cell.border = border_all

    if is_zebra:
      cell.fill = fill_zebra

    if col_idx in [1, 5, 11, 13, 14, 16, 18]:
      cell.alignment = align_center
    elif col_idx in [19]:
      cell.alignment = align_right
      cell.number_format = "$#,##0"
    else:
      cell.alignment = align_left

    if col_idx == 20:
      status_str = str(val)
      if "Converted Client" in status_str:
        cell.fill = fill_converted
        cell.font = font_converted
      elif "Responded" in status_str or "Negotiating" in status_str:
        cell.fill = fill_in_progress
        cell.font = font_in_progress
      elif "Nurture" in status_str:
        cell.fill = fill_nurture
        cell.font = font_nurture
      elif "New Lead" in status_str:
        cell.fill = fill_new
        cell.font = font_new
      cell.alignment = align_center

# Total Row
total_row_idx = len(lead_data) + 7
ws_pipe.row_dimensions[total_row_idx].height = 25
ws_pipe.cell(row=total_row_idx, column=1).value = "TOTAL"
ws_pipe.cell(row=total_row_idx, column=1).font = font_body_bold
ws_pipe.cell(row=total_row_idx, column=1).alignment = align_center

ws_pipe.cell(
    row=total_row_idx, column=19
).value = f"=SUM(S6:S{total_row_idx-2})"
ws_pipe.cell(row=total_row_idx, column=19).font = font_body_bold
ws_pipe.cell(row=total_row_idx, column=19).number_format = "$#,##0"
ws_pipe.cell(row=total_row_idx, column=19).alignment = align_right

ws_pipe.cell(row=total_row_idx, column=20).value = "Pipeline Potential"
ws_pipe.cell(row=total_row_idx, column=20).font = font_body_bold
ws_pipe.cell(row=total_row_idx, column=20).alignment = align_center

for c in range(1, 22):
  cell = ws_pipe.cell(row=total_row_idx, column=c)
  cell.fill = fill_kpi_bg
  cell.border = border_all

# Data Validation
dv_status = DataValidation(
    type="list",
    formula1=(
        '"New Lead - Uncontacted,Warm Text Sent,Loom Video Sent,Responded /'
        ' Negotiating,Converted Client,Perpetual Nurture"'
    ),
    allow_blank=True,
)
dv_channel = DataValidation(
    type="list",
    formula1='"SMS / Text,WhatsApp,IG DM,Phone / Call,LinkedIn DM"',
    allow_blank=True,
)
dv_yesno = DataValidation(
    type="list", formula1='"Yes,No,Pending"', allow_blank=True
)

ws_pipe.add_data_validation(dv_status)
ws_pipe.add_data_validation(dv_channel)
ws_pipe.add_data_validation(dv_yesno)

dv_status.add("T6:T100")
dv_channel.add("E6:E100")
dv_yesno.add("K6:K100")
dv_yesno.add("M6:M100")
dv_yesno.add("N6:N100")
dv_yesno.add("P6:P100")
dv_yesno.add("R6:R100")


