ws_vault.views.sheetView[0].showGridLines = True

ws_vault.merge_cells("A1:C1")
ws_vault.merge_cells("A2:C2")

for r in range(1, 3):
  for c in range(1, 4):
    ws_vault.cell(row=r, column=c).fill = fill_navy_dark

