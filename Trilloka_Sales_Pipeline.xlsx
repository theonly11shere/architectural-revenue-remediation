import openpyxl
from openpyxl.chart import BarChart, Reference
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
from openpyxl.worksheet.datavalidation import DataValidation

# Initialize Workbook
wb = openpyxl.Workbook()

# Setup worksheets
ws_dash = wb.active
ws_dash.title = "Dashboard & Analytics"
ws_pipe = wb.create_sheet(title="Active Pipeline")
ws_vault = wb.create_sheet(title="Outreach Script Vault")

# Color Palette
NAVY_DARK = "0F172A"
NAVY_HEADER = "1E293B"
GOLD_ACCENT = "D4AF37"
ZEBRA_FILL = "F8FAFC"
WHITE = "FFFFFF"
GRAY_TEXT = "64748B"
BORDER_COLOR = "CBD5E1"

# Fonts
font_title = Font(name="Segoe UI", size=16, bold=True, color=GOLD_ACCENT)
font_subtitle = Font(name="Segoe UI", size=10, italic=True, color=WHITE)
font_section = Font(name="Segoe UI", size=13, bold=True, color=NAVY_DARK)
font_header = Font(name="Segoe UI", size=10, bold=True, color=WHITE)
font_body = Font(name="Segoe UI", size=9.5, color="1E293B")
font_body_bold = Font(name="Segoe UI", size=9.5, bold=True, color="1E293B")
font_kpi_num = Font(name="Segoe UI", size=18, bold=True, color=NAVY_DARK)
font_kpi_label = Font(name="Segoe UI", size=8.5, bold=True, color=GRAY_TEXT)

# Fills
fill_navy_dark = PatternFill(
    start_color=NAVY_DARK, end_color=NAVY_DARK, fill_type="solid"
)
fill_header = PatternFill(
    start_color=NAVY_HEADER, end_color=NAVY_HEADER, fill_type="solid"
)
fill_zebra = PatternFill(
    start_color=ZEBRA_FILL, end_color=ZEBRA_FILL, fill_type="solid"
)
fill_kpi_bg = PatternFill(
    start_color="F1F5F9", end_color="F1F5F9", fill_type="solid"
)

fill_converted = PatternFill(
    start_color="DCFCE7", end_color="DCFCE7", fill_type="solid"
)
font_converted = Font(name="Segoe UI", size=9.5, bold=True, color="15803D")

fill_in_progress = PatternFill(
    start_color="FEF9C3", end_color="FEF9C3", fill_type="solid"
)
font_in_progress = Font(name="Segoe UI", size=9.5, bold=True, color="A16207")

fill_nurture = PatternFill(
    start_color="F3E8FF", end_color="F3E8FF", fill_type="solid"
)
font_nurture = Font(name="Segoe UI", size=9.5, bold=True, color="6B21A8")

fill_new = PatternFill(
    start_color="E0F2FE", end_color="E0F2FE", fill_type="solid"
)
font_new = Font(name="Segoe UI", size=9.5, bold=True, color="0369A1")

# Borders & Alignment
thin_side = Side(border_style="thin", color=BORDER_COLOR)
border_all = Border(
    left=thin_side, right=thin_side, top=thin_side, bottom=thin_side
)

align_center = Alignment(horizontal="center", vertical="center", wrap_text=True)
align_left = Alignment(horizontal="left", vertical="center", wrap_text=True)
align_right = Alignment(horizontal="right", vertical="center")

# ==========================================
# TAB 1: DASHBOARD & ANALYTICS
# ==========================================
ws_dash.views.sheetView[0].showGridLines = True

ws_dash.merge_cells("A1:I1")
ws_dash.merge_cells("A2:I2")

for r in range(1, 3):
  for c in range(1, 10):
    ws_dash.cell(row=r, column=c).fill = fill_navy_dark

ws_dash["A1"] = "TRILLOKA | Lead Acquisition & Nurture Dashboard"
ws_dash["A1"].font = font_title
ws_dash["A1"].alignment = Alignment(
    horizontal="left", vertical="center", indent=1
)

ws_dash["A2"] = (
    "Real-Time Sales Tracker • Continuous Outreach Pipeline • Conversion"
    " Analytics"
)
ws_dash["A2"].font = font_subtitle
ws_dash["A2"].alignment = Alignment(
    horizontal="left", vertical="center", indent=1
)

ws_dash.row_dimensions[1].height = 24
ws_dash.row_dimensions[2].height = 18

kpis = [
    ("Total Leads Tracked", "=COUNTA('Active Pipeline'!A6:A20)", "B4:C4", "B5:C5"),
    (
        "Warm Texts Sent",
        '=COUNTIF(\'Active Pipeline\'!K6:K20, "Yes")',
        "D4:E4",
        "D5:E5",
    ),
    ("Looms Sent", '=COUNTIF(\'Active Pipeline\'!M6:M20, "Yes")', "F4:G4", "F5:G5"),
    (
        "Responses Received",
        '=COUNTIF(\'Active Pipeline\'!N6:N20, "Yes")',
        "H4:I4",
        "H5:I5",
    ),
    (
        "Clients Converted",
        '=COUNTIF(\'Active Pipeline\'!T6:T20, "Converted Client")',
        "B7:C7",
        "B8:C8",
    ),
    (
        "Total Revenue Closed",
        "=SUM('Active Pipeline'!S6:S20)",
        "D7:E7",
        "D8:E8",
    ),
    ("Response Rate", "=I5/C5", "F7:G7", "F8:G8"),
    ("Close Rate", "=C8/C5", "H7:I7", "H8:I8"),
]

for label, formula, range_lbl, range_val in kpis:
  ws_dash.merge_cells(range_lbl)
  ws_dash.merge_cells(range_val)

  lbl_cell = ws_dash[range_lbl.split(":")[0]]
  lbl_cell.value = label
  lbl_cell.font = font_kpi_label
  lbl_cell.alignment = align_center

  val_cell = ws_dash[range_val.split(":")[0]]
  val_cell.value = formula
  val_cell.font = font_kpi_num
  val_cell.alignment = align_center

  if "Revenue" in label:
    val_cell.number_format = "$#,##0"
  elif "Rate" in label:
    val_cell.number_format = "0.0%"
  else:
    val_cell.number_format = "#,##0"

  for rng in [range_lbl, range_val]:
    cols = [
        openpyxl.utils.column_index_from_string(s[0]) for s in rng.split(":")
    ]
    row = int(rng.split(":")[0][1:])
    for c in range(cols[0], cols[1] + 1):
      cell = ws_dash.cell(row=row, column=c)
      cell.fill = fill_kpi_bg
      cell.border = border_all

ws_dash.row_dimensions[4].height = 18
ws_dash.row_dimensions[5].height = 28
ws_dash.row_dimensions[7].height = 18
ws_dash.row_dimensions[8].height = 28

ws_dash["B10"] = "Outreach Pipeline Breakdown"
ws_dash["B10"].font = font_section

headers_summary = [
    "Lead Stage / Status",
    "Lead Count",
    "Est. Revenue Potential",
    "Action Required",
]
for col_idx, h in enumerate(headers_summary, start=2):
  cell = ws_dash.cell(row=11, column=col_idx)
  cell.value = h
  cell.font = font_header
  cell.fill = fill_header
  cell.alignment = align_center

summary_rows = [
    (
        "1. New Lead - Uncontacted",
        '=COUNTIF(\'Active Pipeline\'!T6:T20, "New Lead - Uncontacted")',
        (
            "=SUMIF('Active Pipeline'!T6:T20, \"New Lead - Uncontacted\","
            " 'Active Pipeline'!S6:S20)"
        ),
        "Send Initial Warm Text Hook",
    ),
    (
        "2. Warm Text Sent",
        '=COUNTIF(\'Active Pipeline\'!T6:T20, "Warm Text Sent")',
        (
            "=SUMIF('Active Pipeline'!T6:T20, \"Warm Text Sent\", 'Active"
            " Pipeline'!S6:S20)"
        ),
        "Record & Send 45s Loom Video",
    ),
    (
        "3. Loom Video Sent",
        '=COUNTIF(\'Active Pipeline\'!T6:T20, "Loom Video Sent")',
        (
            "=SUMIF('Active Pipeline'!T6:T20, \"Loom Video Sent\", 'Active"
            " Pipeline'!S6:S20)"
        ),
        "Wait 24h then Send Follow-Up 1",
    ),
    (
        "4. Responded / Negotiating",
        '=COUNTIF(\'Active Pipeline\'!T6:T20, "Responded / Negotiating")',
        (
            "=SUMIF('Active Pipeline'!T6:T20, \"Responded / Negotiating\","
            " 'Active Pipeline'!S6:S20)"
        ),
        "Send Audit Proposal & Close Deal",
    ),
    (
        "5. Converted Client",
        '=COUNTIF(\'Active Pipeline\'!T6:T20, "Converted Client")',
        (
            "=SUMIF('Active Pipeline'!T6:T20, \"Converted Client\", 'Active"
            " Pipeline'!S6:S20)"
        ),
        "Deliver Full Remediation Report",
    ),
    (
        "6. Perpetual Nurture",
        '=COUNTIF(\'Active Pipeline\'!T6:T20, "Perpetual Nurture")',
        (
            "=SUMIF('Active Pipeline'!T6:T20, \"Perpetual Nurture\", 'Active"
            " Pipeline'!S6:S20)"
        ),
        "Send Weekly Site Micro-Glitches",
    ),
]

for row_idx, data in enumerate(summary_rows, start=12):
  ws_dash.row_dimensions[row_idx].height = 22
  for col_idx, val in enumerate(data, start=2):
    cell = ws_dash.cell(row=row_idx, column=col_idx)
    cell.value = val
    cell.font = font_body
    cell.border = border_all
    if col_idx == 2:
      cell.alignment = align_left
    elif col_idx == 3:
      cell.alignment = align_center
      cell.number_format = "#,##0"
    elif col_idx == 4:
      cell.alignment = align_right
      cell.number_format = "$#,##0"
    else:
      cell.alignment = align_left

ws_dash.row_dimensions[18].height = 24
ws_dash["B18"] = "Total Pipeline"
ws_dash["B18"].font = font_body_bold
ws_dash["C18"] = "=SUM(C12:C17)"
ws_dash["C18"].font = font_body_bold
ws_dash["C18"].number_format = "#,##0"
ws_dash["D18"] = "=SUM(D12:D17)"
ws_dash["D18"].font = font_body_bold
ws_dash["D18"].number_format = "$#,##0"
ws_dash["E18"] = "Never Stop Nurturing Leads"
ws_dash["E18"].font = Font(
    name="Segoe UI", size=9.5, italic=True, color=GRAY_TEXT
)

for c in range(2, 6):
  cell = ws_dash.cell(row=18, column=c)
  cell.border = border_all
  cell.fill = fill_kpi_bg

# Chart Setup
chart = BarChart()
chart.type = "col"
chart.style = 10
chart.title = "Leads by Pipeline Stage"
chart.y_axis.title = "Number of Leads"
chart.x_axis.title = "Stage"

data_ref = Reference(ws_dash, min_col=3, min_row=11, max_row=17)
cats_ref = Reference(ws_dash, min_col=2, min_row=12, max_row=17)
chart.add_data(data_ref, titles_from_data=True)
chart.set_categories(cats_ref)
chart.width = 15
chart.height = 9
ws_dash.add_chart(chart, "F10")

